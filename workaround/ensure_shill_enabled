logger -t wimax "GCT WiMAX device found."

# /home/chronos may not be mounted when this script is invoked at the early
# stage of boot. /home/chronos should be available during the subsequent
# invocations of this script due to udev change events on the WiMAX device.
if [ ! -e /home/chronos ]; then
  logger -t wimax "/home/chronos does not exist. Skip creating .enable_shill"
  exit 0
fi

if [ -f /home/chronos/.enable_shill ]; then
  exit 0
fi

if [ -f /home/chronos/.disable_shill ]; then
  logger -t wimax "shill is explicitly disabled."
  exit 0
fi

# Create the .enable_shill file to ensure the shill is run by the flimflam
# upstart job.
touch /home/chronos/.enable_shill
logger -t wimax "Enable shill."

# If flimflam is already running, restart the flimflam upstart job to
# run shill instead. Otherwise, shill is already running or will be run
# by upstart at a later moment.
if pgrep flimflam >/dev/null 2>&1; then
  if status flimflam >/dev/null 2>&1; then
    logger -t wimax "Switching from flimflam to shill."
    restart flimflam
  else
    logger -t wimax "flimflam is running but not launched by upstart! \
Defer switching to shill until reboot."
  fi
fi
